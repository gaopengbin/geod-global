{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Only the bundled main window can inspect and control GeoD Global jobs.",
  "windows": ["main"],
  "permissions": [
    "allow-set-desktop-locale",
    "allow-health",
    "allow-diagnostics",
    "allow-get-proxy-settings",
    "allow-save-proxy-settings",
    "allow-test-proxy-settings",
    "allow-list-jobs",
    "allow-list-projects",
    "allow-create-project",
    "allow-rename-project",
    "allow-add-project-scenes",
    "allow-download-project",
    "allow-mosaic-project",
    "allow-create-job",
    "allow-cancel-job",
    "allow-retry-job",
    "allow-inspect-raster",
    "allow-file-thumbnail",
    "allow-sample-raster",
    "allow-prepare-artifact",
    "allow-reveal-artifact",
    "allow-list-recipes",
    "allow-plan-recipe",
    "allow-save-recipe",
    "allow-run-recipe",
    "allow-reveal-job",
    "allow-open-source"
  ]
}
