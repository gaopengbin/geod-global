{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Only the bundled main window can inspect and control GeoD Global jobs.",
  "windows": ["main"],
  "permissions": [
    "allow-health",
    "allow-diagnostics",
    "allow-list-jobs",
    "allow-list-projects",
    "allow-create-project",
    "allow-download-project",
    "allow-mosaic-project",
    "allow-create-job",
    "allow-cancel-job",
    "allow-retry-job",
    "allow-inspect-raster",
    "allow-sample-raster",
    "allow-prepare-artifact",
    "allow-reveal-artifact",
    "allow-list-recipes",
    "allow-plan-recipe",
    "allow-save-recipe",
    "allow-run-recipe",
    "allow-reveal-job",
    "allow-open-source"
  ]
}
