{
  "name": "geod-global",
  "version": "0.1.0-rc.3",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "description": "Independent GeoD Global product repository and desktop workspace design.",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-toast": "1.2.23",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "cesium": "1.146.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.14.0",
    "ol": "10.10.0",
    "proj4": "2.22.0",
    "react": "19.2.5",
    "react-day-picker": "10.0.2",
    "react-dom": "19.2.5",
    "react-resizable-panels": "4.14.1",
    "shadow-plugin": "2.1.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.5",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "jsdom": "29.1.1",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "vite": "8.0.16",
    "vitest": "4.1.11"
  },
  "scripts": {
    "dev": "vite prototype --config prototype/vite.config.mjs",
    "build": "vite build prototype --config prototype/vite.config.mjs",
    "preview": "vite preview prototype --config prototype/vite.config.mjs",
    "runtime": "cargo run --locked -p geod-runtime -- serve --data-dir .geod-global --port 4318",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --debug --no-bundle",
    "package:windows": "powershell -NoProfile -File scripts/package-windows.ps1",
    "test": "node --test prototype/src/*.test.js",
    "test:runtime": "cargo test --locked -p geod-runtime",
    "test:desktop": "cargo test --locked -p geod-global-desktop --features custom-protocol",
    "check:isolation": "node scripts/verify-repository.mjs",
    "check:contracts": "python GeoD-Global-Spec/contracts/verify_contracts.py",
    "check:recipes": "python scripts/check-recipe-schema.py",
    "check": "npm run check:isolation && npm run check:contracts && npm run check:recipes",
    "verify": "npm run check && npm test && npm run test:ui && npm run build",
    "verify:all": "npm run verify && npm run test:runtime && npm run test:desktop",
    "test:ui": "vitest run"
  }
}
