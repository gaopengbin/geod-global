{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:geod:proposed:core:0.1.0-proposed.1",
  "title": "GeoD proposed core contract fixtures; not an implemented API",
  "type": "object",
  "required": ["schemaVersion", "kind", "id"],
  "properties": {
    "schemaVersion": {"const": "0.1.0-proposed.1"},
    "kind": {"enum": ["Area", "Recipe", "Job", "Artifact"]},
    "id": {"$ref": "#/$defs/id"}
  },
  "oneOf": [
    {"$ref": "#/$defs/area"},
    {"$ref": "#/$defs/recipe"},
    {"$ref": "#/$defs/job"},
    {"$ref": "#/$defs/artifact"}
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9._:-]{0,127}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "position": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [
        {"type": "number", "minimum": -180, "maximum": 180},
        {"type": "number", "minimum": -90, "maximum": 90}
      ]
    },
    "ring": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/position"}},
    "polygonCoordinates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ring"}},
    "geometry": {
      "oneOf": [
        {
          "type": "object", "required": ["type", "coordinates"], "additionalProperties": false,
          "properties": {"type": {"const": "Polygon"}, "coordinates": {"$ref": "#/$defs/polygonCoordinates"}}
        },
        {
          "type": "object", "required": ["type", "coordinates"], "additionalProperties": false,
          "properties": {
            "type": {"const": "MultiPolygon"},
            "coordinates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/polygonCoordinates"}}
          }
        }
      ]
    },
    "area": {
      "required": ["name", "originalCrs", "geometry"],
      "properties": {
        "kind": {"const": "Area"}, "name": {"type": "string", "minLength": 1},
        "originalCrs": {"type": "string", "minLength": 1}, "geometry": {"$ref": "#/$defs/geometry"}
      }
    },
    "input": {
      "type": "object", "required": ["id", "providerId", "collectionId", "itemId", "assetKey", "revision"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "providerId": {"$ref": "#/$defs/id"},
        "collectionId": {"type": "string", "minLength": 1}, "itemId": {"type": "string", "minLength": 1},
        "assetKey": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}
      }
    },
    "outputRequirement": {
      "type": "object", "required": ["id", "required", "format"], "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "required": {"type": "boolean"},
        "format": {"enum": ["GeoTIFF", "COG", "GeoPackage", "GeoJSON", "PMTiles", "MBTiles", "3DTiles", "JSON"]}
      }
    },
    "outputPolicy": {"enum": ["all_required", "best_effort"]},
    "recipe": {
      "required": ["version", "areaId", "inputs", "outputPolicy", "outputs", "resourceBudget"],
      "properties": {
        "kind": {"const": "Recipe"}, "version": {"type": "integer", "minimum": 1},
        "areaId": {"$ref": "#/$defs/id"},
        "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/input"}},
        "outputPolicy": {"$ref": "#/$defs/outputPolicy"},
        "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/outputRequirement"}},
        "resourceBudget": {
          "type": "object", "required": ["maxBytes", "maxRequests"], "additionalProperties": false,
          "properties": {"maxBytes": {"type": "integer", "minimum": 1}, "maxRequests": {"type": "integer", "minimum": 1}}
        }
      }
    },
    "error": {
      "type": "object", "required": ["code", "message", "retryable"], "additionalProperties": false,
      "properties": {
        "code": {"enum": ["NO_COVERAGE", "AUTH_REQUIRED", "AUTH_EXPIRED", "POLICY_DENIED", "POLICY_UNKNOWN", "CAPABILITY_UNAVAILABLE", "RATE_LIMITED", "NETWORK_ERROR", "DISK_FULL", "OUTPUT_CONFLICT", "VALIDATION_FAILED", "SCHEMA_UNSUPPORTED", "INPUT_CHANGED", "CANCELLED"]},
        "message": {"type": "string", "minLength": 1}, "retryable": {"type": "boolean"},
        "detailRef": {"$ref": "#/$defs/id"}
      }
    },
    "outputResult": {
      "type": "object", "required": ["id", "required", "status"], "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "required": {"type": "boolean"},
        "status": {"enum": ["pending", "valid", "failed", "skipped"]},
        "artifactId": {"$ref": "#/$defs/id"}, "error": {"$ref": "#/$defs/error"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "valid"}}}, "then": {"required": ["artifactId"], "not": {"required": ["error"]}}},
        {"if": {"properties": {"status": {"enum": ["failed", "skipped"]}}}, "then": {"required": ["error"], "not": {"required": ["artifactId"]}}},
        {"if": {"properties": {"status": {"const": "pending"}}}, "then": {"not": {"anyOf": [{"required": ["artifactId"]}, {"required": ["error"]}]}}}
      ]
    },
    "job": {
      "required": ["recipeId", "attempt", "state", "outputPolicy", "outputs", "artifactIds", "createdAt", "updatedAt"],
      "properties": {
        "kind": {"const": "Job"}, "recipeId": {"$ref": "#/$defs/id"},
        "attempt": {"type": "integer", "minimum": 1}, "retryOf": {"$ref": "#/$defs/id"},
        "state": {"enum": ["Draft", "Validating", "AwaitingApproval", "Queued", "Running", "Paused", "Succeeded", "Partial", "Failed", "Cancelled"]},
        "outputPolicy": {"$ref": "#/$defs/outputPolicy"},
        "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/outputResult"}},
        "artifactIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "createdAt": {"$ref": "#/$defs/timestamp"}, "updatedAt": {"$ref": "#/$defs/timestamp"}
      },
      "allOf": [
        {"if": {"properties": {"state": {"const": "Succeeded"}}}, "then": {"properties": {"outputs": {"items": {"properties": {"status": {"const": "valid"}}}}}}},
        {"if": {"properties": {"state": {"const": "Partial"}}}, "then": {"properties": {"outputs": {"allOf": [
          {"contains": {"properties": {"status": {"const": "valid"}}}},
          {"contains": {"properties": {"status": {"enum": ["failed", "skipped"]}}}}
        ]}}}},
        {"if": {"properties": {"state": {"enum": ["Succeeded", "Partial", "Failed", "Cancelled"]}}}, "then": {"properties": {"outputs": {"items": {"properties": {"status": {"enum": ["valid", "failed", "skipped"]}}}}}}}
      ]
    },
    "file": {
      "type": "object", "required": ["relativePath", "bytes", "sha256"], "additionalProperties": false,
      "properties": {
        "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f]+$"},
        "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "required": ["jobId", "outputId", "files", "provenance", "validation", "committedAt"],
      "properties": {
        "kind": {"const": "Artifact"}, "jobId": {"$ref": "#/$defs/id"}, "outputId": {"$ref": "#/$defs/id"},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
        "provenance": {
          "type": "object", "required": ["inputIds", "engineVersion", "policyRef"], "additionalProperties": false,
          "properties": {
            "inputIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
            "engineVersion": {"type": "string", "minLength": 1}, "policyRef": {"$ref": "#/$defs/id"}
          }
        },
        "validation": {
          "type": "object", "required": ["status", "validatorId", "version", "checkedAt"], "additionalProperties": false,
          "properties": {
            "status": {"const": "valid"}, "validatorId": {"$ref": "#/$defs/id"},
            "version": {"type": "string", "minLength": 1}, "checkedAt": {"$ref": "#/$defs/timestamp"}
          }
        },
        "committedAt": {"$ref": "#/$defs/timestamp"}
      }
    }
  }
}
