{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GeoD Global executable local SCL polygon clip recipe v2",
  "$comment": "v2 adds a WGS84 Polygon/MultiPolygon mask and an intersecting output window that may be narrower than the geometry extent. Runtime also checks ring closure, coordinate ranges, vertex limits, source identity, nodata and pixel intersection.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "source", "operation", "output"],
  "properties": {
    "schemaVersion": { "const": "geod-raster-recipe/v2" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["jobId", "sha256"],
      "properties": {
        "jobId": { "type": "string", "format": "uuid", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false, "required": ["type", "crs", "bounds", "geometry"],
      "properties": {
        "type": { "const": "clip" }, "crs": { "const": "EPSG:4326" },
        "bounds": { "type": "array", "minItems": 4, "maxItems": 4, "prefixItems": [
          { "type": "number", "minimum": -180, "maximum": 180 },
          { "type": "number", "minimum": -80, "maximum": 84 },
          { "type": "number", "minimum": -180, "maximum": 180 },
          { "type": "number", "minimum": -80, "maximum": 84 }
        ] },
        "geometry": {
          "type": "object", "additionalProperties": false, "required": ["type", "coordinates"],
          "properties": {
            "type": { "enum": ["Polygon", "MultiPolygon"] },
            "coordinates": { "type": "array", "minItems": 1 }
          }
        }
      }
    },
    "output": { "type": "object", "additionalProperties": false, "required": ["format"], "properties": { "format": { "const": "GeoTIFF" } } }
  }
}
