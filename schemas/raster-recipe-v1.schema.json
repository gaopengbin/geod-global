{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GeoD Global executable local SCL clip recipe v1",
  "$comment": "Current runtime contract, distinct from the broader proposed design contracts. Source must resolve to a successful local SCL job with exactly this SHA-256; JSON Schema alone cannot establish that. Canonical saved names are trimmed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "source", "operation", "output"],
  "properties": {
    "schemaVersion": { "const": "geod-raster-recipe/v1" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120, "allOf": [{ "pattern": "\\S" }, { "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$" }] },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["jobId", "sha256"],
      "properties": {
        "jobId": { "type": "string", "format": "uuid", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "crs", "bounds"],
      "properties": {
        "type": { "const": "clip" },
        "crs": { "enum": ["source", "EPSG:4326"] },
        "bounds": {
          "description": "[minX,minY,maxX,maxY] in source metres, or [west,south,east,north] in WGS84 degrees within UTM latitudes -80..84. Runtime checks ordering, finite values, longitude span at most 180 degrees and actual intersection.",
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": { "type": "number" }
        }
      },
      "allOf": [{
        "if": { "properties": { "crs": { "const": "EPSG:4326" } } },
        "then": { "properties": { "bounds": { "prefixItems": [
          { "minimum": -180, "maximum": 180 },
          { "minimum": -80, "maximum": 84 },
          { "minimum": -180, "maximum": 180 },
          { "minimum": -80, "maximum": 84 }
        ] } } }
      }]
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["format"],
      "properties": { "format": { "const": "GeoTIFF" } }
    }
  }
}
